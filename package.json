{
  "name": "typescript-7.1-scratch",
  "description": "Layered Bun playground for TypeScript 7.1 content mappers and motherload",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/brendadeeznuts1111/typescript-7.1-scratch.git"
  },
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "bun check",
    "typecheck:playground": "tsc -p playground --noEmit --runExternalCode",
    "playground": "bun --preload motherload/register playground/main.ts",
    "test:contracts": "bun test contracts",
    "ci:local": "bun install --frozen-lockfile && bun run typecheck:playground && bun run playground && bun run test:contracts",
    "typecheck:example": "tsc -p examples/intellisense-markdown --noEmit --runExternalCode",
    "example:intellisense": "bun --preload motherload/register examples/intellisense-markdown/main.ts",
    "typecheck:example-toml": "tsc -p examples/intellisense-toml --noEmit --runExternalCode",
    "example:toml": "bun --preload motherload/register examples/intellisense-toml/main.ts",
    "typecheck:example-csv": "tsc -p examples/intellisense-csv --noEmit --runExternalCode",
    "example:csv": "bun --preload motherload/register examples/intellisense-csv/main.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "motherload": "0.1.0",
    "typescript": "7.1.0-beta"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
