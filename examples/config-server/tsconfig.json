{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  "contentMappers": [
    {
      "package": "motherload",
      "extensions": [".toml", ".csv", ".md"]
    }
  ],
  "include": ["**/*.ts"]
}
