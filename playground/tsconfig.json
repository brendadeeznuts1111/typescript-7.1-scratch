{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true
  },
  "contentMappers": [
    {
      "package": "motherload",
      "extensions": [".toml", ".yaml", ".yml", ".jsonc", ".json5", ".env", ".csv", ".tsv", ".txt", ".md"]
    }
  ],
  "include": ["main.ts", "layers/**/*.ts", "lib/**/*.ts"]
}
